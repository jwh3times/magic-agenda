{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run -s lint)",
      "Bash(npm run format:check)",
      "Bash(npm run -s format:check)",
      "Bash(npm run format)",
      "Bash(npm run -s format)",
      "Bash(npm run build)",
      "Bash(npm run -s build)",
      "Bash(npm run sync:agents:check)",
      "Bash(npm run -s sync:agents:check)",
      "Bash(npm run sync:agents)",
      "Bash(npm run -s sync:agents)",
      "Bash(npm run check:claude-md)",
      "Bash(npm run -s check:claude-md)",
      "Bash(npm run lint:agents)",
      "Bash(npm run -s lint:agents)",
      "Bash(npm test:*)",
      "Bash(npm ci)",
      "Bash(npx vitest run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh project item-list *)",
      "Bash(gh project field-list *)",
      "Bash(nslookup *)",
      "Bash(gh run watch *)",
      "Bash(npx tsc --noEmit)",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id",
      "mcp__cloudflare-api__docs"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/guard.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/guard.mjs",
              "--post"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
