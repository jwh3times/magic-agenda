# Supabase — copy to .env.local and fill in from your project's API settings.
# The anon key is public by design; safety comes from Row-Level Security. Never ship the service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
# Public VAPID key for Web Push. Leave blank to show notifications as unconfigured.
VITE_VAPID_PUBLIC_KEY=
