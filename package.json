{
  "name": "magic-agenda",
  "private": true,
  "version": "1.4.0",
  "description": "A tactile, multi-user task board — a draggable sticky-note calendar that syncs across devices.",
  "license": "MIT",
  "author": "Jerry Holland",
  "homepage": "https://magicagenda.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/jwh3times/magic-agenda.git"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:rls:up": "npx supabase start -x studio,edge-runtime,logflare,vector,imgproxy",
    "test:rls:down": "npx supabase stop",
    "test:e2e": "playwright test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.ts\" playwright.config.ts vitest.rls.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.ts\" playwright.config.ts vitest.rls.config.ts",
    "codex:sync": "node scripts/sync-codex.mjs",
    "codex:check": "node scripts/sync-codex.mjs --check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "supabase": "2.114.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
